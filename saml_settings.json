{
    "strict": true,
    "debug": false,
    "sp": {
        "entityId": "http://goreve.store/saml/metadata",
        "assertionConsumerService": {
            "url": "http://goreve.store/saml/acs",
            "binding": "urn:oasis:names:tc:SAML:2.0:bindings:HTTP-POST"
        },
        "singleLogoutService": {
            "url": "http://goreve.store/saml/sls",
